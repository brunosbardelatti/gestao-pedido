generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  OPERATOR
}

enum OrderStatus {
  OPEN
  RECEIVED
  CANCELED
}

enum SaleStatus {
  COMPLETED
  CANCELED
}

enum PaymentMethod {
  CASH
  PIX
  DEBIT_CARD
  CREDIT_CARD
  BANK_TRANSFER
  OTHER
}

enum InventoryMovementType {
  PURCHASE
  SALE
  SALE_CANCELLATION
  CORRECTION
  PERSONAL_USE
  RETURN
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
}

enum ActorType {
  USER
  API_KEY
  SYSTEM
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @db.VarChar(120)
  login           String   @db.VarChar(80)
  normalizedLogin String   @unique @map("normalized_login") @db.VarChar(80)
  passwordHash    String   @map("password_hash") @db.VarChar(255)
  role            UserRole @default(OPERATOR)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions           Session[]
  createdApiKeys     ApiKey[]            @relation("ApiKeyCreatedBy")
  auditLogs          AuditLog[]          @relation("AuditLogUser")
  idempotencyRecords IdempotencyRecord[] @relation("IdempotencyUser")

  brandsCreated     Brand[]             @relation("BrandCreatedBy")
  brandsUpdated     Brand[]             @relation("BrandUpdatedBy")
  categoriesCreated Category[]          @relation("CategoryCreatedBy")
  categoriesUpdated Category[]          @relation("CategoryUpdatedBy")
  productsCreated   Product[]           @relation("ProductCreatedBy")
  productsUpdated   Product[]           @relation("ProductUpdatedBy")
  ordersCreated     Order[]             @relation("OrderCreatedBy")
  ordersUpdated     Order[]             @relation("OrderUpdatedBy")
  ordersReceived    Order[]             @relation("OrderReceivedBy")
  ordersCanceled    Order[]             @relation("OrderCanceledBy")
  movementsCreated  InventoryMovement[] @relation("InventoryMovementCreatedBy")
  customersCreated  Customer[]          @relation("CustomerCreatedBy")
  customersUpdated  Customer[]          @relation("CustomerUpdatedBy")
  salesCreated      Sale[]              @relation("SaleCreatedBy")
  salesCanceled     Sale[]              @relation("SaleCanceledBy")

  @@index([active])
  @@map("users")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(6)
  ipAddress  String?   @map("ip_address") @db.VarChar(45)
  userAgent  String?   @map("user_agent") @db.VarChar(500)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}

model ApiKey {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @db.VarChar(120)
  keyPrefix   String       @map("key_prefix") @db.VarChar(20)
  keyHash     String       @unique @map("key_hash") @db.VarChar(255)
  scopes      String[]     @default([])
  status      ApiKeyStatus @default(ACTIVE)
  createdById String       @map("created_by_id") @db.Uuid
  expiresAt   DateTime?    @map("expires_at") @db.Timestamptz(6)
  lastUsedAt  DateTime?    @map("last_used_at") @db.Timestamptz(6)
  revokedAt   DateTime?    @map("revoked_at") @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy          User                @relation("ApiKeyCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  auditLogs          AuditLog[]          @relation("AuditLogApiKey")
  idempotencyRecords IdempotencyRecord[] @relation("IdempotencyApiKey")

  @@index([status])
  @@index([createdById])
  @@map("api_keys")
}

model Brand {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @db.VarChar(100)
  normalizedName String   @unique @map("normalized_name") @db.VarChar(100)
  active         Boolean  @default(true)
  createdById    String   @map("created_by_id") @db.Uuid
  updatedById    String   @map("updated_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy User      @relation("BrandCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User      @relation("BrandUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  products  Product[]
  orders    Order[]

  @@index([active])
  @@map("brands")
}

model Category {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @db.VarChar(100)
  normalizedName String   @unique @map("normalized_name") @db.VarChar(100)
  active         Boolean  @default(true)
  createdById    String   @map("created_by_id") @db.Uuid
  updatedById    String   @map("updated_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy User      @relation("CategoryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User      @relation("CategoryUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  products  Product[]

  @@index([active])
  @@map("categories")
}

model Product {
  id                 String   @id @default(uuid()) @db.Uuid
  brandId            String   @map("brand_id") @db.Uuid
  categoryId         String   @map("category_id") @db.Uuid
  code               String   @db.VarChar(80)
  normalizedCode     String   @map("normalized_code") @db.VarChar(80)
  description        String   @db.VarChar(255)
  catalogPrice       Decimal  @map("catalog_price") @db.Decimal(12, 2)
  purchasePrice      Decimal  @map("purchase_price") @db.Decimal(12, 2)
  originalPrice      Decimal  @map("original_price") @db.Decimal(12, 2)
  suggestedSalePrice Decimal? @map("suggested_sale_price") @db.Decimal(12, 2)
  active             Boolean  @default(true)
  createdById        String   @map("created_by_id") @db.Uuid
  updatedById        String   @map("updated_by_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  brand          Brand               @relation(fields: [brandId], references: [id], onDelete: Restrict)
  category       Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy      User                @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy      User                @relation("ProductUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  orderItems     OrderItem[]
  saleItems      SaleItem[]
  stockMovements InventoryMovement[]

  @@unique([brandId, normalizedCode])
  @@index([description])
  @@index([brandId, active])
  @@index([categoryId, active])
  @@map("products")
}

model Order {
  id           String      @id @default(uuid()) @db.Uuid
  brandId      String      @map("brand_id") @db.Uuid
  cycle        String      @db.VarChar(80)
  orderDate    DateTime    @map("order_date") @db.Date
  receivedAt   DateTime?   @map("received_at") @db.Timestamptz(6)
  canceledAt   DateTime?   @map("canceled_at") @db.Timestamptz(6)
  cancelReason String?     @map("cancel_reason") @db.VarChar(500)
  status       OrderStatus @default(OPEN)
  notes        String?     @db.Text
  createdById  String      @map("created_by_id") @db.Uuid
  updatedById  String      @map("updated_by_id") @db.Uuid
  receivedById String?     @map("received_by_id") @db.Uuid
  canceledById String?     @map("canceled_by_id") @db.Uuid
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  brand      Brand       @relation(fields: [brandId], references: [id], onDelete: Restrict)
  createdBy  User        @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy  User        @relation("OrderUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  receivedBy User?       @relation("OrderReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)
  canceledBy User?       @relation("OrderCanceledBy", fields: [canceledById], references: [id], onDelete: Restrict)
  items      OrderItem[]

  @@index([brandId, cycle])
  @@index([status, orderDate])
  @@index([orderDate])
  @@map("orders")
}

model OrderItem {
  id                String    @id @default(uuid()) @db.Uuid
  orderId           String    @map("order_id") @db.Uuid
  productId         String    @map("product_id") @db.Uuid
  quantityOrdered   Int       @map("quantity_ordered")
  quantityReceived  Int       @default(0) @map("quantity_received")
  catalogUnitPrice  Decimal   @map("catalog_unit_price") @db.Decimal(12, 2)
  purchaseUnitPrice Decimal   @map("purchase_unit_price") @db.Decimal(12, 2)
  originalUnitPrice Decimal   @map("original_unit_price") @db.Decimal(12, 2)
  expirationDate    DateTime? @map("expiration_date") @db.Date
  notes             String?   @db.VarChar(500)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  order          Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product        Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  stockMovements InventoryMovement[]

  @@unique([orderId, productId])
  @@index([productId])
  @@index([expirationDate])
  @@map("order_items")
}

model Customer {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(150)
  cpf         String?  @unique @db.VarChar(11)
  phone       String?  @db.VarChar(20)
  addressLine String?  @map("address_line") @db.VarChar(255)
  city        String?  @db.VarChar(100)
  state       String?  @db.Char(2)
  postalCode  String?  @map("postal_code") @db.VarChar(8)
  active      Boolean  @default(true)
  createdById String   @map("created_by_id") @db.Uuid
  updatedById String   @map("updated_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy User   @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User   @relation("CustomerUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  sales     Sale[]

  @@index([name])
  @@index([active])
  @@map("customers")
}

model Sale {
  id            String         @id @default(uuid()) @db.Uuid
  customerId    String?        @map("customer_id") @db.Uuid
  status        SaleStatus     @default(COMPLETED)
  saleDate      DateTime       @default(now()) @map("sale_date") @db.Timestamptz(6)
  paymentMethod PaymentMethod? @map("payment_method")
  total         Decimal        @db.Decimal(12, 2)
  notes         String?        @db.Text
  canceledAt    DateTime?      @map("canceled_at") @db.Timestamptz(6)
  cancelReason  String?        @map("cancel_reason") @db.VarChar(500)
  createdById   String         @map("created_by_id") @db.Uuid
  canceledById  String?        @map("canceled_by_id") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy  User       @relation("SaleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  canceledBy User?      @relation("SaleCanceledBy", fields: [canceledById], references: [id], onDelete: Restrict)
  items      SaleItem[]

  @@index([saleDate])
  @@index([status, saleDate])
  @@index([customerId])
  @@map("sales")
}

model SaleItem {
  id               String   @id @default(uuid()) @db.Uuid
  saleId           String   @map("sale_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  quantity         Int
  unitPrice        Decimal  @map("unit_price") @db.Decimal(12, 2)
  unitCostSnapshot Decimal  @map("unit_cost_snapshot") @db.Decimal(12, 2)
  subtotal         Decimal  @db.Decimal(12, 2)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  sale           Sale                @relation(fields: [saleId], references: [id], onDelete: Restrict)
  product        Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  stockMovements InventoryMovement[]

  @@unique([saleId, productId])
  @@index([productId])
  @@map("sale_items")
}

/// Ledger imutável de estoque.
/// quantityDelta deve ser positivo para entrada e negativo para saída.
model InventoryMovement {
  id            String                @id @default(uuid()) @db.Uuid
  productId     String                @map("product_id") @db.Uuid
  orderItemId   String?               @map("order_item_id") @db.Uuid
  saleItemId    String?               @map("sale_item_id") @db.Uuid
  type          InventoryMovementType
  quantityDelta Int                   @map("quantity_delta")
  reason        String?               @db.VarChar(500)
  createdById   String                @map("created_by_id") @db.Uuid
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  product   Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  saleItem  SaleItem?  @relation(fields: [saleItemId], references: [id], onDelete: Restrict)
  createdBy User       @relation("InventoryMovementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([productId, createdAt])
  @@index([type, createdAt])
  @@index([orderItemId])
  @@index([saleItemId])
  @@map("inventory_movements")
}

model AuditLog {
  id         String    @id @default(uuid()) @db.Uuid
  actorType  ActorType @map("actor_type")
  userId     String?   @map("user_id") @db.Uuid
  apiKeyId   String?   @map("api_key_id") @db.Uuid
  action     String    @db.VarChar(120)
  entityType String    @map("entity_type") @db.VarChar(120)
  entityId   String?   @map("entity_id") @db.Uuid
  requestId  String?   @map("request_id") @db.VarChar(100)
  metadata   Json?
  occurredAt DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)

  user   User?   @relation("AuditLogUser", fields: [userId], references: [id], onDelete: SetNull)
  apiKey ApiKey? @relation("AuditLogApiKey", fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([occurredAt])
  @@index([userId, occurredAt])
  @@index([apiKeyId, occurredAt])
  @@map("audit_logs")
}

model IdempotencyRecord {
  id             String            @id @default(uuid()) @db.Uuid
  key            String            @db.VarChar(120)
  scope          String            @db.VarChar(120)
  requestHash    String            @map("request_hash") @db.VarChar(255)
  status         IdempotencyStatus @default(PROCESSING)
  actorType      ActorType         @map("actor_type")
  userId         String?           @map("user_id") @db.Uuid
  apiKeyId       String?           @map("api_key_id") @db.Uuid
  responseStatus Int?              @map("response_status")
  responseBody   Json?             @map("response_body")
  expiresAt      DateTime          @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  user   User?   @relation("IdempotencyUser", fields: [userId], references: [id], onDelete: SetNull)
  apiKey ApiKey? @relation("IdempotencyApiKey", fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@unique([scope, key])
  @@index([expiresAt])
  @@index([status])
  @@map("idempotency_records")
}

/**
 * CHECK CONSTRAINTS RECOMENDADAS PARA A PRIMEIRA MIGRATION SQL
 * products:
 * catalog_price >= 0
 * purchase_price >= 0
 * original_price >= 0
 * suggested_sale_price >= 0
 * order_items:
 * quantity_ordered > 0
 * quantity_received >= 0
 * quantity_received <= quantity_ordered
 * catalog_unit_price >= 0
 * purchase_unit_price >= 0
 * original_unit_price >= 0
 * sale_items:
 * quantity > 0
 * unit_price >= 0
 * unit_cost_snapshot >= 0
 * subtotal = quantity * unit_price
 * sales:
 * total >= 0
 * inventory_movements:
 * quantity_delta <> 0
 * customers:
 * cpf deve conter somente 11 dígitos quando informado
 * postal_code deve conter somente 8 dígitos quando informado
 * state deve conter exatamente 2 caracteres quando informado
 * Regras entre campos que devem ser validadas na aplicação:
 * - Order RECEIVED exige received_at e received_by_id.
 * - Order CANCELED exige canceled_at e canceled_by_id.
 * - Sale CANCELED exige canceled_at e canceled_by_id.
 * - PURCHASE deve referenciar order_item_id.
 * - SALE e SALE_CANCELLATION devem referenciar sale_item_id.
 * - Ajustes manuais não devem referenciar order_item_id ou sale_item_id.
 * - Apenas um entre user_id e api_key_id deve ser preenchido para atores não SYSTEM.
 */
